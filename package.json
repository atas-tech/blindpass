{
  "name": "blindpass",
  "private": true,
  "license": "SEE LICENSE IN LICENSES.md",
  "version": "0.1.0",
  "engines": {
    "node": "^24.21.0 || ^26.10.0"
  },
  "workspaces": [
    "packages/*",
    "helpers/*"
  ],
  "scripts": {
    "generate:api": "node scripts/generate-controller-types.mjs",
    "test:controller-openapi": "node scripts/tests/controller-openapi.test.mjs",
    "test:contract-progress": "node --test scripts/tests/assert-contract-progress.test.mjs",
    "test:p02:clients": "node --import=tsx scripts/tests/p02-rust-client-flows.mjs",
    "test:p02:crash": "node --import=tsx scripts/tests/p02-rust-crash-recovery.mjs",
    "test:p05:fixture": "node --test --test-isolation=none tests/browser-handoff/fixture-app/*.test.mjs",
    "test:p05:oauth": "node --test --test-isolation=none tests/browser-handoff/oauth-fixture.test.mjs",
    "test:p05:grafana": "node --test --test-isolation=none tests/browser-handoff/managed-grafana.test.mjs",
    "build:i18n": "npm run build --workspace=@blindpass/i18n",
    "build": "npm run build:i18n && npm run build --workspaces --if-present",
    "build:skill": "bash scripts/build_bundle.sh",
    "install:skill": "bash scripts/install_skill.sh",
    "publish:dist": "bash scripts/publish_dist.sh",
    "publish:clawhub": "bash scripts/publish_clawhub.sh",
    "dev": "npm run dev --workspaces --if-present",
    "test": "node scripts/tests/run-workspace-tests.mjs",
    "test:landing": "node --check landing/dist/script.js && node --check landing/dist/reel.js && node --test landing/tests/workflow.test.mjs landing/tests/reel.test.mjs landing/tests/assets.test.mjs landing/tests/release-gate.test.mjs && npm run test:ui-assets",
    "test:desktop": "sh scripts/test-desktop.sh",
    "test:ui-assets": "node scripts/sync-ui-assets.mjs --check && node --test assets/ui/tests/tokens.test.mjs",
    "sync:ui-assets": "node scripts/sync-ui-assets.mjs",
    "test:skill-install": "node scripts/tests/install_skill.test.mjs",
    "test:release-metadata": "node scripts/tests/release_metadata.test.mjs",
    "test:retirement": "node --test scripts/tests/retirement-inventory.test.mjs && scripts/retirement/inventory.sh --check && scripts/retirement/inventory.sh | diff -u docs/release/retirement-inventory.md -",
    "test:exposure": "python3 scripts/tests/canary_scan_test.py && python3 scripts/tests/check_core_limits_test.py && python3 scripts/tests/check-core-limits.py deploy && python3 tests/deployment/canary_log_scan_test.py && python3 tests/fleet/p07_export_test.py && python3 tests/fleet/p06_scan_logs_test.py",
    "test:audience-packaging": "node scripts/tests/audience_packaging.test.mjs",
    "test:openclaw-activation": "node scripts/tests/openclaw_activation.test.mjs",
    "test:p05:helper": "node --test --test-isolation=none tests/browser-handoff/private-login.test.mjs tests/browser-handoff/private-login-browser.test.mjs tests/browser-handoff/private-login-worker.test.mjs tests/browser-handoff/private-login-worker-browser.test.mjs",
    "test:p05:helper:grafana": "node --test tests/browser-handoff/private-login-grafana.test.mjs",
    "test:p05:stock-channel": "node --test tests/browser-handoff/stock-browser-channel.test.mjs"
  },
  "dependencies": {
    "hpke-js": "^1.7.0"
  },
  "devDependencies": {
    "@types/pg": "^8.18.0",
    "pg": "^8.20.0"
  }
}
