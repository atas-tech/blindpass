[Unit]
Description=BlindPass native encrypted-credential baseline consumer

[Service]
Type=oneshot
User=blindpass-consumer
Group=blindpass-consumer
RuntimeDirectory=blindpass-consumer-native
RuntimeDirectoryMode=0700
LoadCredentialEncrypted=api-key:/etc/blindpass/api-key.cred
ExecStart=/usr/libexec/blindpass-consumer --credential-file %d/api-key --prefix P01-
RemainAfterExit=yes
LimitCORE=0

[Install]
WantedBy=multi-user.target
