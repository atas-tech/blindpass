[Unit]
Description=BlindPass private login helper instance

[Service]
Type=exec
User=blindpass-login
Group=blindpass-login
ExecStart=/usr/lib/blindpass/login/runtime/bin/node /usr/lib/blindpass/login/src/worker.mjs --socket
StandardInput=socket
StandardOutput=inherit
StandardError=null
Environment=HOME=/nonexistent
Environment=PATH=/usr/bin:/bin
Environment=PLAYWRIGHT_BROWSERS_PATH=/usr/lib/blindpass/login/browsers
UnsetEnvironment=NODE_OPTIONS DEBUG PWDEBUG NODE_PATH LD_PRELOAD LD_LIBRARY_PATH
UMask=0077
RuntimeMaxSec=60s
TimeoutStopSec=5s
KillMode=control-group
SendSIGKILL=yes
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# V8/Chromium require executable memory and user namespaces for their sandbox.
# Do not set MemoryDenyWriteExecute=yes or disable the Chromium sandbox.
# Network scope: this unit sets no RestrictAddressFamilies and no IPAddressDeny/IPAddressAllow because
# Chromium reaches the application directly and the destination is a runtime recipe value. The destination
# restriction is enforced in code: private-login.mjs fails every request outside the recipe origin(s)
# through the CDP Fetch domain (each redirect hop included) and closes WebSockets. Optional hardening for
# deployments that can name the destination (IPAddressDeny=any with IPAddressAllow= for the application
# and DNS resolver addresses, and a RestrictAddressFamilies candidate) is described in
# deploy/examples/browser-runtime.conf; it is not enabled here and has not been VM-verified.
