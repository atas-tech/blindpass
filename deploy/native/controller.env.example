# SPDX-License-Identifier: AGPL-3.0-only
# The native installer writes this file (0640 root:blindpass); this example
# documents its keys. Initialize keys explicitly, register the printed issuer
# key ID in the external authority, then run the database initialization.
BLINDPASS_LISTEN=127.0.0.1:3200
BLINDPASS_PUBLIC_URL=https://blindpass.example
BLINDPASS_UI_BASE_URL=https://blindpass.example
BLINDPASS_KEYS_DIR=/etc/blindpass/keys
BLINDPASS_DATA_DIR=/var/lib/blindpass/controller
BLINDPASS_ADMIN_SOCKET_PATH=/run/blindpass-controller/admin.sock
BLINDPASS_LOG_FORMAT=json
# The authority credential, tenant ID and owner ID (BLINDPASS_AUTHORITY_URL_FILE,
# BLINDPASS_CONTROLLER_TENANT_ID, BLINDPASS_CONTROLLER_OWNER_ID) are set by the
# installer-written authority.conf drop-in of the serve, initialize and
# reconcile-clock units only, never in this shared file or the offline backup unit.
# Required edge mode rejects direct API/UI access. The edge must overwrite Host,
# X-Forwarded-Host, X-Forwarded-Proto and X-Forwarded-For (never append a chain).
BLINDPASS_PROXY_REQUIRED=1
BLINDPASS_TRUST_PROXY=127.0.0.1,::1
# Individual *_SECRET_FILE / BLINDPASS_ISSUER_KEY_FILE values override key roots.
# PostgreSQL uses a private URL file; conversion from SQLite is unsupported.
# BLINDPASS_DATABASE_URL_FILE=/etc/blindpass/database.url
