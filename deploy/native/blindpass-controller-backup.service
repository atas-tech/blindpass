# SPDX-License-Identifier: AGPL-3.0-only
# Installed disabled. Explicit protected custody is required: a signing credential
# and the offline recipient's certificate. The recipient private key never lives here.
[Unit]
Description=BlindPass encrypted controller backup
Requires=blindpass-controller-backup-credential-check.service
After=blindpass-controller-backup-credential-check.service
ConditionPathExists=/etc/blindpass/controller-backup-enabled
ConditionPathExists=/etc/blindpass/controller-backup-signing-credential
ConditionPathExists=/etc/blindpass/controller-backup-recipient-certificate

[Service]
User=blindpass
Group=blindpass
UMask=0077
EnvironmentFile=/etc/blindpass/controller.env
Environment=BLINDPASS_ROOT_SECRET_FILE=%d/root-secret
Environment=BLINDPASS_AGENT_JWT_SECRET_FILE=%d/agent-jwt-secret
Environment=BLINDPASS_ISSUER_KEY_FILE=%d/issuer-key
LoadCredential=root-secret:/etc/blindpass/keys/root-secret
LoadCredential=agent-jwt-secret:/etc/blindpass/keys/agent-jwt-secret
LoadCredential=issuer-key:/etc/blindpass/keys/issuer-key
StateDirectory=blindpass/controller
StateDirectoryMode=0700
RuntimeDirectory=blindpass-controller-backup
RuntimeDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/var/lib/blindpass/controller /run/blindpass-controller-backup
ReadOnlyPaths=/etc/blindpass/keys
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
LimitCORE=0
LimitNOFILE=8192
KillMode=control-group
# Capture, hashing, encryption and full verification each have bounded work.
# Give the complete job its own budget; retain control-group termination.
TimeoutStartSec=15min
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
Type=oneshot
LoadCredential=signing-credential:/etc/blindpass/controller-backup-signing-credential
LoadCredential=recipient-certificate:/etc/blindpass/controller-backup-recipient-certificate
ExecStart=/opt/blindpass/controller/current/bin/blindpass backup create --output /var/lib/blindpass/controller/backups --signing-credential-file %d/signing-credential --recipient-certificate-file %d/recipient-certificate
