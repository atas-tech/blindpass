[Unit]
Description=BlindPass locked upgrade with an automatic verified pre-upgrade backup
# Run only while the controller is stopped and the authority record is fenced.
Conflicts=blindpass-controller.service
ConditionPathExists=/etc/blindpass/controller-initialized
ConditionPathExists=/etc/blindpass/controller-backup-signing-credential
ConditionPathExists=/etc/blindpass/controller-backup-recipient-certificate

[Service]
User=blindpass
Group=blindpass
UMask=0077
EnvironmentFile=/etc/blindpass/controller.env
Environment=BLINDPASS_ROOT_SECRET_FILE=%d/root-secret
Environment=BLINDPASS_AGENT_JWT_SECRET_FILE=%d/agent-jwt-secret
Environment=BLINDPASS_ISSUER_KEY_FILE=%d/issuer-key
LoadCredential=root-secret:/etc/blindpass/keys/root-secret
LoadCredential=agent-jwt-secret:/etc/blindpass/keys/agent-jwt-secret
LoadCredential=issuer-key:/etc/blindpass/keys/issuer-key
LoadCredential=signing-credential:/etc/blindpass/controller-backup-signing-credential
LoadCredential=recipient-certificate:/etc/blindpass/controller-backup-recipient-certificate
StateDirectory=blindpass/controller
StateDirectoryMode=0700
RuntimeDirectory=blindpass-controller-upgrade
RuntimeDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/var/lib/blindpass/controller /run/blindpass-controller-upgrade
ReadOnlyPaths=/etc/blindpass/keys
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
LimitCORE=0
LimitNOFILE=8192
KillMode=control-group
# Encrypted capture, verification and the migration each have bounded work.
TimeoutStartSec=15min
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
Type=oneshot
ExecStart=/opt/blindpass/controller/current/bin/blindpass migrate --pre-upgrade-backup-dir /var/lib/blindpass/controller/pre-upgrade-backups --signing-credential-file %d/signing-credential --recipient-certificate-file %d/recipient-certificate
