# SPDX-License-Identifier: AGPL-3.0-only
g blindpass-workload -
u blindpass-agent - "BlindPass registered workload" /nonexistent /usr/sbin/nologin
u blindpass-consumer - "BlindPass credential consumer" /nonexistent /usr/sbin/nologin
u blindpass-backup - "BlindPass backup probe" /nonexistent /usr/sbin/nologin
m blindpass-agent blindpass-workload
