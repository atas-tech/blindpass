[Unit]
Description=BlindPass validated native credential consumer
Requires=blindpass-broker.service
After=blindpass-broker.service

[Service]
Type=oneshot
KillMode=control-group
TimeoutStartSec=5s
User=blindpass-consumer
Group=blindpass-consumer
RuntimeDirectory=blindpass-consumer
RuntimeDirectoryMode=0700
LoadCredential=api-key:/run/blindpass/loader.sock
ExecStart=/usr/libexec/blindpass-consumer --credential-file %d/api-key --prefix P01-
RemainAfterExit=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/blindpass-consumer
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
LimitCORE=0
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
