# SPDX-License-Identifier: AGPL-3.0-only
[Unit]
Description=BlindPass original backup credential custody check
ConditionPathExists=/etc/blindpass/controller-backup-enabled
ConditionPathExists=/etc/blindpass/controller-backup-signing-credential
ConditionPathExists=/etc/blindpass/controller-backup-recipient-certificate

[Service]
Type=oneshot
User=root
Group=root
# No credential delivery or contents read by this metadata-only preflight.
ExecStart=/usr/bin/python3 -I /opt/blindpass/controller/current/deploy/native/controller-backup-credential-check.py
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
LimitCORE=0
TimeoutStartSec=10
TimeoutStopSec=5
StandardInput=null
StandardOutput=journal
StandardError=journal
