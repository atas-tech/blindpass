# SPDX-License-Identifier: AGPL-3.0-only
[Unit]
Description=BlindPass root-only isolated browser activation

[Socket]
ListenStream=/run/blindpass-private/browser.sock
SocketUser=root
SocketGroup=root
SocketMode=0600
DirectoryMode=0700
Accept=yes
MaxConnections=16
RemoveOnStop=yes
Service=blindpass-browser@.service

[Install]
WantedBy=sockets.target
