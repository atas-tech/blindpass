[Unit]
Description=BlindPass Root website administrator revoker
[Service]
Type=exec
User=root
Group=root
ExecStart=/usr/lib/blindpass/login/runtime/bin/node /usr/lib/blindpass/login/src/session-revoker-worker.mjs --socket
StandardInput=socket
StandardOutput=null
StandardError=null
Environment=HOME=/nonexistent
Environment=PATH=/usr/bin:/bin
UnsetEnvironment=NODE_OPTIONS NODE_PATH DEBUG PWDEBUG LD_PRELOAD LD_LIBRARY_PATH
UMask=0077
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitCORE=0
RuntimeMaxSec=32min
TimeoutStopSec=5s
KillMode=control-group
SendSIGKILL=yes
# Fixed fixture HTTPS or Root Unix application route; no browser dependency.
