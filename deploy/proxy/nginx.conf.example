# SPDX-License-Identifier: AGPL-3.0-only
# Include in nginx's http context. Replace both example authorities and PEMs;
# keep them identical to BLINDPASS_PUBLIC_URL / BLINDPASS_UI_BASE_URL.
# BLINDPASS_PROXY_REQUIRED=1, BLINDPASS_TRUST_PROXY=127.0.0.1,::1
# Requests can carry signed links. This example writes no request/error logs.

server {
    listen 443 ssl default_server;
    server_name blindpass.example;
    ssl_certificate /etc/nginx/blindpass/fullchain.pem;
    ssl_certificate_key /etc/nginx/blindpass/private-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /dev/null crit;
    if ($host != blindpass.example) { return 421; }
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:3200;
        proxy_http_version 1.1;
        proxy_set_header Host blindpass.example;
        proxy_set_header X-Forwarded-Host blindpass.example;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_hide_header Strict-Transport-Security;
        proxy_connect_timeout 5s;
        proxy_read_timeout 40s;
        proxy_send_timeout 10s;
        proxy_buffering off;
        proxy_cache off;
    }
}

server {
    listen 443 ssl;
    server_name input.example;
    ssl_certificate /etc/nginx/blindpass/fullchain.pem;
    ssl_certificate_key /etc/nginx/blindpass/private-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /dev/null crit;
    if ($host != input.example) { return 421; }
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:3200;
        proxy_http_version 1.1;
        proxy_set_header Host input.example;
        proxy_set_header X-Forwarded-Host input.example;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_hide_header Strict-Transport-Security;
        proxy_connect_timeout 5s;
        proxy_read_timeout 40s;
        proxy_send_timeout 10s;
        proxy_buffering off;
        proxy_cache off;
    }
}
