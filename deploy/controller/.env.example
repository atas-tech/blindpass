# Public deployment choices only; never place passwords/keys in this file.
BLINDPASS_CONTROLLER_IMAGE=ghcr.io/atas-tech/blindpass-controller:0.1.0
BLINDPASS_PUBLIC_URL=https://blindpass.example
BLINDPASS_UI_BASE_URL=https://input.example
BLINDPASS_EDGE_SUBNET=172.29.6.0/24
BLINDPASS_CONTROLLER_IP=172.29.6.2
# Assign this exact IP to your separate HTTPS edge on the edge network.
BLINDPASS_TRUST_PROXY=172.29.6.3
# PostgreSQL profile only: protected paths, not secret values.
# BLINDPASS_DATABASE_CONFIG_DIR=/srv/blindpass/controller-config
# BLINDPASS_POSTGRES_PASSWORD_FILE=/srv/blindpass/private/postgres-password
