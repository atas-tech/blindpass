# BlindPass development example environment.
# The controller's own configuration is deploy/controller/.env.example (Compose) and
# deploy/native/controller.env.example (native). This file holds only what the source tree still reads: the
# disposable PostgreSQL service for the Rust PostgreSQL suites and the retained client settings.

# -----------------------------------------------------------------------------
# Disposable PostgreSQL (docker-compose.test.yml) for the Rust PostgreSQL suites
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=localdev
DATABASE_URL=postgresql://blindpass:localdev@127.0.0.1:5433/blindpass

# -----------------------------------------------------------------------------
# Client runtime configuration (gateway, agent runtime, OpenClaw plugin, MCP bundle)
# -----------------------------------------------------------------------------
# The published bundle has no default endpoint: set the controller URL explicitly.
SPS_BASE_URL=http://127.0.0.1:3100
BLINDPASS_API_KEY=
SPS_AGENT_API_KEY=
BLINDPASS_AGENT_ID=blindpass-agent

# -----------------------------------------------------------------------------
# Frontend build-time configuration (the older name of VITE_BLINDPASS_API_ORIGIN)
# -----------------------------------------------------------------------------
VITE_SPS_API_URL=http://127.0.0.1:3100
