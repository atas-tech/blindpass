server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # P04 input CSP. __CONNECT_SRC__ is replaced at image build by
    # scripts/render-nginx-conf.mjs with exactly the controller origin the
    # bundle was built for (VITE_SPS_API_URL), so the header can never differ
    # from the bundle or carry a loopback origin into a release image.
    # HSTS is set by the TLS terminator in front of this container, not here.
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src __CONNECT_SRC__; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cache-Control "no-store" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
