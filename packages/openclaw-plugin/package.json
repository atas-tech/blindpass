{
    "name": "@blindpass/openclaw-plugin",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "main": "index.mjs",
    "bin": {
        "blindpass-openclaw-migrate": "./bin/blindpass-openclaw-migrate"
    },
    "scripts": {
        "build": "bash ../../scripts/build_bundle.sh",
        "install:skill": "bash ../../scripts/install_skill.sh",
        "publish:dist": "bash ../../scripts/publish_dist.sh",
        "publish:clawhub": "bash ../../scripts/publish_clawhub.sh",
        "test": "node tests/index.test.mjs && node --test tests/sps-base-url.test.mjs && node --test \"tests/migrate/*.test.mjs\""
    },
    "openclaw": {
        "extensions": [
            "./index.mjs"
        ]
    },
    "description": "Zero-knowledge secret provisioning via HPKE encryption. Registers a request_secret tool for the agent.",
    "keywords": [
        "openclaw",
        "plugin",
        "secrets",
        "hpke"
    ],
    "dependencies": {},
    "engines": {
        "node": "^24.21.0 || ^26.10.0"
    }
}
