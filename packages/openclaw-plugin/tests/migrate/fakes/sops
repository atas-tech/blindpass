#!/usr/bin/env node
import { readFileSync as __rf } from "node:fs";
import { dirname as __dn, join as __jn } from "node:path";
import { fileURLToPath as __fp } from "node:url";
const FAKE = (() => { try { return JSON.parse(__rf(__jn(__dn(__fp(import.meta.url)), "fakes.json"), "utf8")); } catch { return {}; } })();
// Test double for sops. "Encrypts" by wrapping the JSON with the recipient from the creation rule and
// refuses to "decrypt" unless SOPS_AGE_KEY_FILE holds the matching public key, so missing/wrong key
// behaviour is real. Real sops is exercised only in the disposable VM (tests/openclaw).
import { appendFileSync, readFileSync } from "node:fs";
import path from "node:path";

const args = process.argv.slice(2);
if (FAKE.log) {
    appendFileSync(FAKE.log, `sops ${args[0] ?? ""}\n`);
}
const fail = (message, code = 1) => { process.stderr.write(`${message}\n`); process.exit(code); };
const flag = (name) => { const i = args.indexOf(name); return i >= 0 ? args[i + 1] : undefined; };
const publicKeyOf = (file) => /^# public key: (age1\S+)/m.exec(readFileSync(file, "utf8"))?.[1];

if (args[0] === "--version") {
    process.stdout.write(`sops ${FAKE.sopsVersion ?? "3.13.3"} (fake)\n`);
} else if (args[0] === "encrypt") {
    const override = flag("--filename-override");
    const config = process.env.SOPS_CONFIG;
    if (!config || !override) fail("error loading config: no matching creation rules found");
    const text = readFileSync(config, "utf8");
    const regex = /path_regex: '([^']*)'/.exec(text)?.[1];
    const recipient = /age: '([^']*)'/.exec(text)?.[1];
    if (!regex || !new RegExp(regex).test(path.relative(path.dirname(config), override))) fail("error loading config: no matching creation rules found");
    const stdin = readFileSync(0, "utf8");
    process.stdout.write(`${JSON.stringify({ fake_sops: 1, recipient, payload: Buffer.from(stdin).toString("base64") })}\n`);
} else if (args[0] === "--decrypt") {
    const file = args.at(-1);
    let document;
    try { document = JSON.parse(readFileSync(file, "utf8")); } catch { fail("failed to load file"); }
    const keyFile = process.env.SOPS_AGE_KEY_FILE;
    if (!keyFile) fail("Failed to get the data key required to decrypt the SOPS file.", 128);
    let pub;
    try { pub = publicKeyOf(keyFile); } catch { fail("Failed to get the data key required to decrypt the SOPS file.", 128); }
    if (pub !== document.recipient) fail("Failed to get the data key required to decrypt the SOPS file.", 128);
    process.stdout.write(Buffer.from(document.payload, "base64").toString("utf8"));
} else {
    fail(`fake sops: unsupported invocation ${args[0]}`);
}
