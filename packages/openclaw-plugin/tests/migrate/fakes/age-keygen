#!/usr/bin/env node
import { readFileSync as __rf } from "node:fs";
import { dirname as __dn, join as __jn } from "node:path";
import { fileURLToPath as __fp } from "node:url";
const FAKE = (() => { try { return JSON.parse(__rf(__jn(__dn(__fp(import.meta.url)), "fakes.json"), "utf8")); } catch { return {}; } })();
import { randomBytes } from "node:crypto";
import { appendFileSync, readFileSync } from "node:fs";

const args = process.argv.slice(2);
if (FAKE.log) {
    appendFileSync(FAKE.log, `age-keygen ${args[0] ?? ""}\n`);
}
if (args[0] === "-y") {
    process.stdout.write(`${/^# public key: (age1\S+)/m.exec(readFileSync(args[1], "utf8"))[1]}\n`);
} else if (args[0] === "--version") {
    process.stdout.write("v1.3.2 (fake)\n");
} else {
    const pub = `age1${randomBytes(29).toString("hex").slice(0, 58)}`;
    process.stdout.write(`# created: 2026-10-07T00:00:00Z\n# public key: ${pub}\nAGE-SECRET-KEY-1${randomBytes(29).toString("hex").toUpperCase().slice(0, 58)}\n`);
    process.stderr.write(`Public key: ${pub}\n`);
}
